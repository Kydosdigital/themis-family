# Leave the origin empty for a non-indexed local/preview build.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_LAUNCH_STATE=prelaunch
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_MEDIA_EMAIL=
# Disabled by default. "local" works ONLY under next dev, never next start.
FORM_PROVIDER=disabled
# Configure at most one provider; GTM takes precedence. Requires a reviewed consent/cookie inventory.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
